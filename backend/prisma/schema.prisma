// SurePesa — core data model.
//
// Money rules (apply everywhere):
//   * Amounts are BigInt in the currency's MINOR units (TZS 1,500.00 => 150000).
//   * Every movement of money is a Transaction with ledger entries that sum to zero
//     per currency (double-entry). Wallet.balance is a cached projection of the ledger
//     and must always equal SUM(ledger_entries.amount) for that wallet.
//   * Nothing outside src/services/ledger.service.ts writes to Wallet.balance or LedgerEntry.

generator client {
  provider        = "prisma-client-js"
  // Single-query relation loading: nested includes become one SQL statement instead of one
  // round trip per relation (each round trip to Neon costs ~300 ms from East Africa).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (runtime)
  directUrl = env("DIRECT_URL") // Neon direct connection (migrations)
}

// ───────────────────────────── Enums ─────────────────────────────

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum UserStatus {
  PENDING_VERIFICATION // registered, phone not yet verified
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AdminRole {
  SUPER_ADMIN // "System Controller": full operational oversight
  COMPLIANCE // KYC review, account status
  SUPPORT // "Customer Service": lookup, cases, reversal *requests* (cannot move money)
  FINANCE // approves reversals, reconciliation
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseCategory {
  PAYMENT_ISSUE
  WRONG_RECIPIENT
  ACCOUNT_ACCESS
  KYC
  FRAUD_REPORT
  GENERAL
}

enum ApprovalType {
  TRANSACTION_REVERSAL
  TRANSACTION_REFUND // full or partial refund of a merchant payment; amount on the request
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  NATIONAL_ID // NIDA
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  SELFIE
  BUSINESS_REGISTRATION // BRELA certificate
  TIN_CERTIFICATE
  BUSINESS_LICENSE
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PIN_RESET
  PASSWORD_RESET
}

enum WalletKind {
  USER // individual customer wallet
  BUSINESS // merchant wallet
  SYSTEM_FLOAT // mirror of money held at an external rail (simulated for now); may go negative
  SYSTEM_FEES // fee revenue
  SYSTEM_FX // FX position for currency conversion
  CARD // prepaid balance of one virtual card
  ESCROW_HOLDING // dedicated per-deal escrow holding wallet; only the Escrow service may post to it
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  DEPOSIT // external rail -> wallet
  WITHDRAWAL // wallet -> external rail
  P2P_TRANSFER // user -> user
  MERCHANT_PAYMENT // user -> business
  REVERSAL // compensating transaction for a previous one
  REFUND // full or partial return of a merchant payment, linked to the original
  CARD_LOAD // user wallet -> virtual card
  CARD_UNLOAD // virtual card -> user wallet
  CARD_PURCHASE // card spend authorised by the issuer (card -> issuer float)
  CARD_REFUND // merchant refund to a card (issuer float -> card)
  FX_CONVERSION // wallet(currency A) -> wallet(currency B)
  ESCROW_HOLD // buyer wallet -> per-deal escrow holding wallet
  ESCROW_RELEASE // escrow holding wallet -> seller settlement
  ESCROW_REFUND // escrow holding wallet -> buyer refund
  ADJUSTMENT // manual finance correction (admin, audited)
}

enum TransactionStatus {
  PENDING // created, not yet sent for processing
  PROCESSING // being processed / awaiting provider confirmation
  SUCCESS
  FAILED
  REVERSED
  CANCELLED
}

enum LedgerEntryType {
  PRINCIPAL
  FEE
  FX
  REVERSAL
  ADJUSTMENT
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  ESCROW_ADJUSTMENT
}

enum PaymentMethodType {
  MOBILE_MONEY
  BANK_ACCOUNT
  CARD
}

enum PaymentMethodStatus {
  PENDING_VERIFICATION
  VERIFIED
  DISABLED
}

enum QrCodeType {
  STATIC // customer enters the amount
  DYNAMIC // amount fixed by merchant, single use
}

enum NotificationChannel {
  IN_APP
  SMS
  PUSH
  EMAIL
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

// ─────────────────────────── Identity ───────────────────────────

model User {
  id              String      @id @default(uuid()) @db.Uuid
  // Identity lives in Neon Auth (Managed Better Auth, schema `neon_auth`); this is its user id (JWT `sub`).
  authUserId      String?     @unique @map("auth_user_id")
  phoneNumber     String?     @unique @map("phone_number") // E.164, e.g. +255712345678 — collected at onboarding
  email           String?     @unique
  accountType     AccountType @default(INDIVIDUAL) @map("account_type")
  status          UserStatus  @default(PENDING_VERIFICATION)
  passwordHash    String?     @map("password_hash") // unused while Neon Auth owns passwords
  pinHash         String?     @map("pin_hash") // transaction PIN, set after registration
  pinAttempts     Int         @default(0) @map("pin_attempts")
  pinLockedAt     DateTime?   @map("pin_locked_at")
  phoneVerifiedAt DateTime?   @map("phone_verified_at")
  kycStatus       KycStatus   @default(NOT_STARTED) @map("kyc_status") // denormalised from latest submission
  lastLoginAt     DateTime?   @map("last_login_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  profile               Profile?
  businesses            Business[]
  wallets               Wallet[]
  kycSubmissions        KycSubmission[]
  paymentMethods        PaymentMethod[]
  initiatedTransactions Transaction[]   @relation("TransactionInitiator")
  notifications         Notification[]
  refreshTokens         RefreshToken[]
  supportCases          SupportCase[]
  virtualCards          VirtualCard[]
  pushBillRequests      PushBillSession[]     @relation("PushBillRequester")
  pushBillPayments      PushBillSession[]     @relation("PushBillPayer")
  pushBillConfirmations PushBillConfirmation[]
  circlesOwned          Circle[]              @relation("CircleOwner")
  circleMemberships     CircleMember[]
  circleInvitesSent     CircleInvitation[]    @relation("CircleInviter")
  circleInvitesReceived CircleInvitation[]    @relation("CircleInvitee")
  escrowBuying          EscrowCase[]          @relation("EscrowBuyer")
  escrowSelling         EscrowCase[]          @relation("EscrowSeller")
  escrowEvidence        EscrowEvidence[]
  escrowDisputesOpened  EscrowDispute[]       @relation("EscrowDisputeOpener")
  fxQuotes              FxQuote[]
  crossBorderSent       CrossBorderTransfer[] @relation("CrossBorderSender")
  crossBorderReceived   CrossBorderTransfer[] @relation("CrossBorderRecipient")

  @@map("users")
}

model Profile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  firstName   String    @map("first_name")
  middleName  String?   @map("middle_name")
  lastName    String    @map("last_name")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?
  nationality String?   @default("TZ") // ISO 3166-1 alpha-2
  region      String?
  district    String?
  street      String?
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Business {
  id             String    @id @default(uuid()) @db.Uuid
  ownerId        String    @map("owner_id") @db.Uuid
  merchantCode   String    @unique @map("merchant_code") // public id used in QR codes, e.g. SPM482193
  legalName      String    @map("legal_name")
  tradingName    String    @map("trading_name")
  registrationNo String?   @map("registration_no") // BRELA
  tin            String?
  category       String?
  phoneNumber    String?   @map("phone_number")
  email          String?
  region         String?
  address        String?
  kycStatus      KycStatus @default(NOT_STARTED) @map("kyc_status")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  owner           User              @relation(fields: [ownerId], references: [id])
  wallets         Wallet[]
  qrCodes         QrCode[]
  kycSubmissions  KycSubmission[]
  pushBillSessions PushBillSession[]

  @@index([ownerId])
  @@map("businesses")
}

model AdminUser {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  fullName            String    @map("full_name")
  passwordHash        String    @map("password_hash")
  role                AdminRole
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  kycReviews         KycSubmission[]
  casesCreated       SupportCase[]     @relation("CaseCreatedBy")
  casesAssigned      SupportCase[]     @relation("CaseAssignedTo")
  caseNotes          SupportCaseNote[]
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecidedBy")

  @@map("admin_users")
}

// ───────────────────────── Back office ──────────────────────────

// A customer-service case: a complaint, query or incident about a customer.
model SupportCase {
  id            String              @id @default(uuid()) @db.Uuid
  reference     String              @unique // CS-XXXXXXXX, quoted to the customer
  userId        String              @map("user_id") @db.Uuid
  transactionId String?             @map("transaction_id") @db.Uuid
  category      SupportCaseCategory
  priority      SupportCasePriority @default(NORMAL)
  status        SupportCaseStatus   @default(OPEN)
  subject       String
  createdById   String              @map("created_by_id") @db.Uuid
  assignedToId  String?             @map("assigned_to_id") @db.Uuid
  resolvedAt    DateTime?           @map("resolved_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id])
  transaction Transaction?      @relation(fields: [transactionId], references: [id])
  createdBy   AdminUser         @relation("CaseCreatedBy", fields: [createdById], references: [id])
  assignedTo  AdminUser?        @relation("CaseAssignedTo", fields: [assignedToId], references: [id])
  notes       SupportCaseNote[]
  approvals   ApprovalRequest[]

  @@index([status, priority, createdAt])
  @@index([userId])
  @@index([assignedToId, status])
  @@map("support_cases")
}

model SupportCaseNote {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  case   SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author AdminUser   @relation(fields: [authorId], references: [id])

  @@index([caseId, createdAt])
  @@map("support_case_notes")
}

// Maker-checker: a sensitive action requested by one staff member and decided by another.
model ApprovalRequest {
  id            String         @id @default(uuid()) @db.Uuid
  type          ApprovalType
  status        ApprovalStatus @default(PENDING)
  transactionId String?        @map("transaction_id") @db.Uuid
  caseId        String?        @map("case_id") @db.Uuid
  amount        BigInt? // TRANSACTION_REFUND: minor units to refund
  reason        String
  requestedById String         @map("requested_by_id") @db.Uuid
  decidedById   String?        @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?      @map("decided_at")
  decisionNote  String?        @map("decision_note")
  createdAt     DateTime       @default(now()) @map("created_at")

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  case        SupportCase? @relation(fields: [caseId], references: [id])
  requestedBy AdminUser    @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   AdminUser?   @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([status, createdAt])
  @@index([transactionId])
  @@map("approval_requests")
}

model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  phoneNumber String     @map("phone_number")
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") // never store the raw code
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([phoneNumber, purpose, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────────────────────── KYC ──────────────────────────────

model KycSubmission {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String?         @map("user_id") @db.Uuid // individual KYC
  businessId      String?         @map("business_id") @db.Uuid // business KYB
  status          KycStatus       @default(PENDING)
  // Snapshot of what was declared at submission time (profile may change later).
  fullName        String          @map("full_name")
  dateOfBirth     DateTime?       @map("date_of_birth") @db.Date
  idType          KycDocumentType @map("id_type")
  idNumber        String          @map("id_number")
  declaredData    Json?           @map("declared_data")
  submittedAt     DateTime        @default(now()) @map("submitted_at")
  reviewedById    String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?       @map("reviewed_at")
  rejectionReason String?         @map("rejection_reason")

  user       User?         @relation(fields: [userId], references: [id])
  business   Business?     @relation(fields: [businessId], references: [id])
  reviewedBy AdminUser?    @relation(fields: [reviewedById], references: [id])
  documents  KycDocument[]

  @@index([status, submittedAt])
  @@index([userId])
  @@index([businessId])
  @@map("kyc_submissions")
}

model KycDocument {
  id           String          @id @default(uuid()) @db.Uuid
  submissionId String          @map("submission_id") @db.Uuid
  type         KycDocumentType
  storageKey   String          @map("storage_key") // key in private object storage, never a public URL
  mimeType     String          @map("mime_type")
  sizeBytes    Int             @map("size_bytes")
  sha256       String
  createdAt    DateTime        @default(now()) @map("created_at")

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("kyc_documents")
}

// ────────────────────────── Money core ──────────────────────────

model Currency {
  code       String  @id // ISO 4217: TZS, USD, KES ...
  name       String
  minorUnits Int     @map("minor_units") // 2 => amounts stored in cents
  symbol     String?
  isActive   Boolean @default(true) @map("is_active")

  wallets Wallet[]

  @@map("currencies")
}

model Wallet {
  id            String       @id @default(uuid()) @db.Uuid
  kind          WalletKind
  userId        String?      @map("user_id") @db.Uuid
  businessId    String?      @map("business_id") @db.Uuid
  systemCode    String?      @unique @map("system_code") // e.g. FLOAT_SIMULATED_TZS, FEES_TZS
  cardId        String?      @unique @map("card_id") @db.Uuid // CARD wallets: the card it funds
  currencyCode  String       @map("currency_code")
  // Cached projection of SUM(ledger_entries.amount). Written only by the ledger service.
  balance       BigInt       @default(0)
  allowNegative Boolean      @default(false) @map("allow_negative") // only system float/FX wallets
  status        WalletStatus @default(ACTIVE)
  version       Int          @default(0) // bumped on every posting
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user     User?        @relation(fields: [userId], references: [id])
  business Business?    @relation(fields: [businessId], references: [id])
  card     VirtualCard? @relation(fields: [cardId], references: [id])
  currency Currency     @relation(fields: [currencyCode], references: [code])
  escrowCase EscrowCase?

  ledgerEntries        LedgerEntry[]
  outgoingTransactions Transaction[] @relation("SourceWallet")
  incomingTransactions Transaction[] @relation("DestinationWallet")

  // One wallet per owner per currency.
  @@unique([userId, currencyCode])
  @@unique([businessId, currencyCode])
  @@index([kind])
  @@map("wallets")
}

// A business-level money movement ("Send TZS 25,000 to John").
// Its ledger entries describe exactly how balances changed.
model Transaction {
  id        String            @id @default(uuid()) @db.Uuid
  reference String            @unique // customer-facing id, e.g. SPX-7K2M9QX4TB
  type      TransactionType
  status    TransactionStatus @default(PENDING)

  initiatorUserId  String? @map("initiator_user_id") @db.Uuid
  initiatorAdminId String? @map("initiator_admin_id") @db.Uuid
  idempotencyKey   String? @map("idempotency_key")

  sourceWalletId      String? @map("source_wallet_id") @db.Uuid
  destinationWalletId String? @map("destination_wallet_id") @db.Uuid

  amount                  BigInt // principal in `currencyCode` minor units
  currencyCode            String   @map("currency_code")
  fee                     BigInt   @default(0) // charged to the source, same currency
  // Cross-currency: what the destination receives.
  destinationAmount       BigInt?  @map("destination_amount")
  destinationCurrencyCode String?  @map("destination_currency_code")
  exchangeRateId          String?  @map("exchange_rate_id") @db.Uuid
  exchangeRate            Decimal? @map("exchange_rate") @db.Decimal(24, 10) // snapshot at execution

  description           String?
  paymentMethodId       String? @map("payment_method_id") @db.Uuid
  qrCodeId              String? @map("qr_code_id") @db.Uuid
  providerName          String? @map("provider_name") // SIMULATED, MPESA_TZ, AIRTEL_TZ, NMB ...
  providerReference     String? @map("provider_reference")
  failureCode           String? @map("failure_code")
  failureReason         String? @map("failure_reason")
  reversesTransactionId String? @unique @map("reverses_transaction_id") @db.Uuid
  refundsTransactionId  String? @map("refunds_transaction_id") @db.Uuid
  metadata              Json?

  // External rails (deposits/withdrawals) while the outcome is not final.
  railStatus       String?   @map("rail_status") // last ProviderStatus seen: PENDING, AMBIGUOUS ...
  nextRailCheckAt  DateTime? @map("next_rail_check_at") // when the rail-sync job should query the rail
  railCheckCount   Int       @default(0) @map("rail_check_count")
  escalatedAt      DateTime? @map("escalated_at") // unresolved after the retry window; Finance must act
  escalationReason String?   @map("escalation_reason")

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  initiator         User?           @relation("TransactionInitiator", fields: [initiatorUserId], references: [id])
  sourceWallet      Wallet?         @relation("SourceWallet", fields: [sourceWalletId], references: [id])
  destinationWallet Wallet?         @relation("DestinationWallet", fields: [destinationWalletId], references: [id])
  exchangeRateRef   ExchangeRate?   @relation(fields: [exchangeRateId], references: [id])
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  qrCode            QrCode?         @relation(fields: [qrCodeId], references: [id])
  reverses          Transaction?    @relation("Reversal", fields: [reversesTransactionId], references: [id])
  reversedBy        Transaction?    @relation("Reversal")
  refunds           Transaction?    @relation("Refund", fields: [refundsTransactionId], references: [id])
  refundedBy        Transaction[]   @relation("Refund")
  providerEvents    ProviderEvent[]

  ledgerEntries LedgerEntry[]
  events        TransactionEvent[]
  supportCases  SupportCase[]
  approvals     ApprovalRequest[]
  pushBillSession PushBillSession?
  contributionRecords ContributionRecord[]
  escrowFundingCases EscrowCase[]
  escrowPayouts EscrowPayout[]
  crossBorderTransfer CrossBorderTransfer?

  // Same client retry => same transaction.
  @@unique([initiatorUserId, idempotencyKey])
  @@unique([providerName, providerReference])
  @@index([sourceWalletId, createdAt])
  @@index([destinationWalletId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([status, nextRailCheckAt])
  @@index([refundsTransactionId])
  @@map("transactions")
}

// Inbox of provider callbacks. Every delivery is stored once (unique per provider event id)
// before it is acted on, so duplicate and out-of-order deliveries are harmless.
model ProviderEvent {
  id            BigInt    @id @default(autoincrement())
  providerName  String    @map("provider_name")
  eventId       String    @map("event_id")
  transactionId String?   @map("transaction_id") @db.Uuid
  status        String // ProviderStatus reported by the rail
  payload       Json // parsed, verified callback (never the raw signature)
  outcome       String? // APPLIED, ALREADY_FINAL, UNKNOWN_TRANSACTION, NOT_FINAL ...
  receivedAt    DateTime  @default(now()) @map("received_at")
  processedAt   DateTime? @map("processed_at")

  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([providerName, eventId])
  @@index([transactionId])
  @@map("provider_events")
}

// Fee schedule as data, so pricing and regulatory caps (e.g. BoT wallet-to-bank caps)
// change without a deploy. The newest active rule per type whose effectiveFrom has passed wins.
model FeeRule {
  id              String          @id @default(uuid()) @db.Uuid
  transactionType TransactionType @map("transaction_type")
  bps             Int // percentage component, 100 bps = 1%
  minFee          BigInt          @map("min_fee") // minor units
  maxFee          BigInt?         @map("max_fee") // minor units; null = uncapped
  note            String? // e.g. "BoT circular, effective 2025-07-01"
  active          Boolean         @default(true)
  effectiveFrom   DateTime        @default(now()) @map("effective_from")
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([transactionType, active, effectiveFrom])
  @@map("fee_rules")
}

// Append-only status history of a transaction.
model TransactionEvent {
  id            BigInt             @id @default(autoincrement())
  transactionId String             @map("transaction_id") @db.Uuid
  fromStatus    TransactionStatus? @map("from_status")
  toStatus      TransactionStatus  @map("to_status")
  actorType     ActorType          @default(SYSTEM) @map("actor_type")
  actorId       String?            @map("actor_id")
  note          String?
  data          Json?
  createdAt     DateTime           @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, id])
  @@map("transaction_events")
}

// Append-only double-entry ledger. Positive = credit to wallet, negative = debit.
// For every transaction, SUM(amount) per currency = 0.
model LedgerEntry {
  id            BigInt          @id @default(autoincrement())
  transactionId String          @map("transaction_id") @db.Uuid
  walletId      String          @map("wallet_id") @db.Uuid
  entryType     LedgerEntryType @map("entry_type")
  amount        BigInt
  currencyCode  String          @map("currency_code")
  balanceAfter  BigInt          @map("balance_after")
  createdAt     DateTime        @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  wallet      Wallet      @relation(fields: [walletId], references: [id])

  @@index([walletId, id])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ──────────────────── Payment methods & QR ─────────────────────

model PaymentMethod {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  type          PaymentMethodType
  provider      String // MPESA_TZ, AIRTEL_TZ, YAS_TZ, HALOPESA, CRDB, NMB, NBC ...
  label         String? // "My M-Pesa"
  accountName   String?             @map("account_name")
  // Full identifier is only needed by the provider adapter; UI shows the masked form.
  accountNumber String              @map("account_number")
  maskedNumber  String              @map("masked_number") // +255 7** *** 678
  currencyCode  String              @default("TZS") @map("currency_code")
  status        PaymentMethodStatus @default(PENDING_VERIFICATION)
  isDefault     Boolean             @default(false) @map("is_default")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@unique([userId, type, provider, accountNumber])
  @@map("payment_methods")
}

model QrCode {
  id           String     @id @default(uuid()) @db.Uuid
  businessId   String     @map("business_id") @db.Uuid
  type         QrCodeType @default(STATIC)
  token        String     @unique // opaque value encoded in surepesa://pay?qr=<token>
  label        String? // "Till 1", "Counter A"
  amount       BigInt? // DYNAMIC only
  currencyCode String     @default("TZS") @map("currency_code")
  isActive     Boolean    @default(true) @map("is_active")
  expiresAt    DateTime?  @map("expires_at")
  usedAt       DateTime?  @map("used_at") // DYNAMIC: single use
  createdAt    DateTime   @default(now()) @map("created_at")

  business     Business          @relation(fields: [businessId], references: [id])
  transactions Transaction[]
  pushBillSessions PushBillSession[]

  @@index([businessId])
  @@map("qr_codes")
}

// ───────────────────────────── FX ───────────────────────────────

// 1 unit of baseCurrency = rate units of quoteCurrency (major units).
model ExchangeRate {
  id            String    @id @default(uuid()) @db.Uuid
  baseCurrency  String    @map("base_currency")
  quoteCurrency String    @map("quote_currency")
  rate          Decimal   @db.Decimal(24, 10)
  source        String    @default("MANUAL") // MANUAL, BOT (Bank of Tanzania), provider name
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  transactions Transaction[]
  fxQuotes     FxQuote[]

  @@index([baseCurrency, quoteCurrency, effectiveFrom])
  @@map("exchange_rates")
}

// ───────────────────── Notifications & audit ────────────────────

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// Append-only record of privileged / sensitive actions.
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String // KYC_APPROVED, USER_SUSPENDED, TRANSACTION_REVERSED ...
  entityType String    @map("entity_type")
  entityId   String?   @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorType, actorId, createdAt])
  @@map("audit_logs")
}

// ──────────────────────────── Virtual cards ────────────────────────────

enum VirtualCardStatus {
  REQUESTED // asked the issuer; waiting for it to be issued
  ACTIVE
  FROZEN // blocked by the customer; can be unfrozen
  CLOSED // terminated; remaining balance returned to the wallet
  FAILED // the issuer refused to issue it
}

// A prepaid virtual card (Visa/Mastercard) issued through a card issuer (e.g. Selcom VCN).
// PCI: the full card number and CVV are NEVER stored or logged here. They live at the issuer
// and are fetched on demand after a PIN check, or delivered by the issuer itself.
model VirtualCard {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  issuerName          String            @map("issuer_name") // SIMULATED, SELCOM ...
  issuerCardId        String?           @map("issuer_card_id") // the issuer's id for the card
  status              VirtualCardStatus @default(REQUESTED)
  nickname            String // "Online shopping", "Netflix"
  brand               String            @default("VISA")
  last4               String?
  expiryMonth         Int?              @map("expiry_month")
  expiryYear          Int?              @map("expiry_year")
  currencyCode        String            @default("TZS") @map("currency_code")
  perTransactionLimit BigInt?           @map("per_transaction_limit") // minor units; null = only the balance limits spend
  validityMonths      Int               @default(24) @map("validity_months")
  failureReason       String?           @map("failure_reason")
  frozenAt            DateTime?         @map("frozen_at")
  closedAt            DateTime?         @map("closed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  user   User        @relation(fields: [userId], references: [id])
  wallet Wallet?
  events CardEvent[]

  @@unique([issuerName, issuerCardId])
  @@index([userId, status])
  @@map("virtual_cards")
}

// Inbox of issuer events (authorisations, reversals, refunds). Stored once per issuer event id
// before acting on it, so redeliveries never charge twice.
model CardEvent {
  id            BigInt    @id @default(autoincrement())
  issuerName    String    @map("issuer_name")
  eventId       String    @map("event_id")
  cardId        String?   @map("card_id") @db.Uuid
  kind          String // AUTHORIZATION, REVERSAL, REFUND
  authId        String?   @map("auth_id") // the issuer's authorisation id, links reversals/refunds
  amount        BigInt
  currencyCode  String    @map("currency_code")
  merchantName  String?   @map("merchant_name")
  transactionId String?   @map("transaction_id") @db.Uuid
  decision      String? // APPROVED, DECLINED
  declineReason String?   @map("decline_reason")
  payload       Json
  receivedAt    DateTime  @default(now()) @map("received_at")
  processedAt   DateTime? @map("processed_at")

  card VirtualCard? @relation(fields: [cardId], references: [id])

  @@unique([issuerName, eventId])
  @@index([cardId, receivedAt])
  @@index([issuerName, authId])
  @@map("card_events")
}

// ──────────────────────────── PushBill ★ ────────────────────────────
//
// A requester at a merchant/agent asks another SurePesa user to pay. The payment is
// authorised only AFTER an ordinary cellular voice call between the two parties and an
// explicit payer confirmation (blueprint §6). No answer / decline / mismatch / expiry
// means no payment. A PIN is never collected during the call.

enum PushBillState {
  CREATED // request captured, destination not yet verified
  DESTINATION_VERIFIED // server resolved the merchant/agent destination
  PAYER_SELECTED // payer bound to the session
  PAYER_NOTIFIED // payer received the in-app/USSD notification
  CALL_REQUESTED // voice gateway asked to bridge the call
  CALLING // call legs being established
  CALL_CONNECTED // both parties on the call — NOT by itself payment consent
  BOTH_PARTIES_CONFIRMED // each party explicitly confirmed merchant/amount/purpose
  AWAITING_PAYER_AUTH // call done; payer must authorise in app or fresh USSD session
  PAYMENT_PROCESSING // payer authorised; selected provider executing
  PAID // terminal: provider success verified
  // Terminal / exception states:
  DECLINED // payer declined
  NO_ANSWER // call unanswered
  CALL_FAILED
  MISMATCH // parties confirmed different details
  EXPIRED
  CANCELLED
  PAYMENT_FAILED
  PAYMENT_UNKNOWN // provider outcome uncertain: reconcile before any retry
  REVIEW_REQUIRED
}

enum PushBillDestinationKind {
  QR_CODE // scanned SurePesa/TANQR merchant QR
  MERCHANT_CODE // manually entered Lipa Namba / merchant code
  AGENT_NUMBER // manually entered agent number
}

enum PushBillRole {
  REQUESTER
  PAYER
}

enum PushBillConfirmationMethod {
  IN_APP
  USSD
}

enum PushBillConfirmationResult {
  CONFIRMED
  REJECTED
  MISMATCH // what the party heard does not match the session terms
}

enum VoiceCallStatus {
  REQUESTED
  RINGING
  CONNECTED
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
}

// One PushBill request and its whole lifecycle. The approved amount and destination are
// pinned by termsHash at approval time; any mutation after payer approval is rejected.
model PushBillSession {
  id           String        @id @default(uuid()) @db.Uuid
  reference    String        @unique // customer-facing id, e.g. PB-7K2M9QX4TB
  requesterId  String        @map("requester_id") @db.Uuid
  payerId      String?       @map("payer_id") @db.Uuid // null until PAYER_SELECTED
  state        PushBillState @default(CREATED)

  destinationKind   PushBillDestinationKind @map("destination_kind")
  destinationInput  String                  @map("destination_input") // what the requester typed / the scanned token
  destinationLabel  String?                 @map("destination_label") // verified name shown to BOTH parties
  businessId        String?                 @map("business_id") @db.Uuid // resolved merchant destination
  qrCodeId          String?                 @map("qr_code_id") @db.Uuid

  amount       BigInt // minor units
  currencyCode String  @default("TZS") @map("currency_code")
  note         String? // purpose/reference from the requester
  // sha256 over (destination + amount + currency) captured when the payer approves.
  termsHash    String? @map("terms_hash")

  idempotencyKey       String?  @map("idempotency_key")
  paymentTransactionId String?  @unique @map("payment_transaction_id") @db.Uuid // the actual payment; the session itself moves no money
  expiresAt            DateTime @map("expires_at") // one-time, short-lived session
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  requester         User                   @relation("PushBillRequester", fields: [requesterId], references: [id])
  payer             User?                  @relation("PushBillPayer", fields: [payerId], references: [id])
  business          Business?              @relation(fields: [businessId], references: [id])
  qrCode            QrCode?                @relation(fields: [qrCodeId], references: [id])
  paymentTransaction Transaction?          @relation(fields: [paymentTransactionId], references: [id])
  confirmations     PushBillConfirmation[]
  callAttempts      VoiceCallAttempt[]
  events            PushBillEvent[]

  @@unique([requesterId, idempotencyKey])
  @@index([requesterId, createdAt])
  @@index([payerId, createdAt])
  @@index([state, expiresAt]) // the expiry job sweeps open sessions
  @@map("pushbill_sessions")
}

// One party's explicit confirmation of the details discussed on the call. The detailsHash
// proves WHAT was confirmed, so "yes" to the wrong amount is a MISMATCH, not a consent.
model PushBillConfirmation {
  id          String                      @id @default(uuid()) @db.Uuid
  sessionId   String                      @map("session_id") @db.Uuid
  userId      String                      @map("user_id") @db.Uuid
  role        PushBillRole
  method      PushBillConfirmationMethod
  detailsHash String                      @map("details_hash") // hash of the details the party was shown
  result      PushBillConfirmationResult
  createdAt   DateTime                    @default(now()) @map("created_at")

  session PushBillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
  @@map("pushbill_confirmations")
}

// One bridged-call attempt through the voice provider. Call audio is NEVER stored.
// An answered call is not consent: authorisation happens afterwards, in app or fresh USSD.
model VoiceCallAttempt {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String         @map("session_id") @db.Uuid
  provider       String // voice carrier name; webhook signature-verified
  providerCallId String?        @map("provider_call_id") // the bridge/conference id
  requesterLegId String?        @map("requester_leg_id")
  payerLegId     String?        @map("payer_leg_id")
  status         VoiceCallStatus @default(REQUESTED)
  failureCode    String?        @map("failure_code")
  lastEventId    String?        @map("last_event_id") // last webhook event applied: redeliveries are no-ops
  requestedAt    DateTime       @default(now()) @map("requested_at")
  connectedAt    DateTime?      @map("connected_at")
  endedAt        DateTime?      @map("ended_at")

  session PushBillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([provider, providerCallId])
  @@index([sessionId, requestedAt])
  @@map("voice_call_attempts")
}

// Append-only state/event history of a PushBill session.
model PushBillEvent {
  id         BigInt         @id @default(autoincrement())
  sessionId  String         @map("session_id") @db.Uuid
  fromState  PushBillState? @map("from_state")
  toState    PushBillState  @map("to_state")
  actorType  ActorType      @default(SYSTEM) @map("actor_type")
  actorId    String?        @map("actor_id")
  note       String?
  data       Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  session PushBillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
  @@map("pushbill_events")
}

// ──────────────────────────── Circles ★ ────────────────────────────
//
// Open group goal/contribution tracking (blueprint §8). Circles are monitoring and
// coordination tools ONLY: they never hold, move or control members' money. A
// contribution is PROVIDER_CONFIRMED only when it is backed by a completed SurePesa
// transaction; everything else is UNVERIFIED (self-reported).

enum CircleType {
  FAMILY
  STUDENT
  VIKOBA
  FRIENDS
  CUSTOM
}

enum CircleStatus {
  ACTIVE
  ARCHIVED // read-only; kept for history/reports
}

enum CircleRole {
  OWNER
  ADMIN
  MEMBER
}

enum CircleMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum CircleInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum CircleGoalStatus {
  ACTIVE
  ACHIEVED
  CANCELLED
}

enum ContributionFrequency {
  ONCE
  WEEKLY
  MONTHLY
}

enum ContributionSource {
  SELF_REPORT // the member typed it in; unverified by definition
  PAYMENT_TRANSACTION // backed by a completed SurePesa transaction
}

enum ContributionVerification {
  UNVERIFIED // self-reported; never shown as confirmed money
  PROVIDER_CONFIRMED // tied to a SUCCESS transaction executed by the member
}

// One group around a shared purpose. Family/Student/Vikoba/Friends are templates on
// this single engine — the type only changes defaults and labels.
model Circle {
  id           String       @id @default(uuid()) @db.Uuid
  reference    String       @unique // customer-facing id, e.g. CIR-7K2M9QX4TB
  ownerId      String       @map("owner_id") @db.Uuid
  name         String
  purpose      String?
  type         CircleType
  status       CircleStatus @default(ACTIVE)
  currencyCode String       @default("TZS") @map("currency_code")
  targetAmount BigInt?      @map("target_amount") // minor units; optional overall target
  targetDate   DateTime?    @map("target_date") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  owner        User                @relation("CircleOwner", fields: [ownerId], references: [id])
  members      CircleMember[]
  invitations  CircleInvitation[]
  goals        CircleGoal[]
  contributions ContributionRecord[]
  events       CircleEvent[]

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("circles")
}

model CircleMember {
  id        String             @id @default(uuid()) @db.Uuid
  circleId  String             @map("circle_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  role      CircleRole         @default(MEMBER)
  status    CircleMemberStatus @default(ACTIVE)
  // Reminder preference (CircleNotificationPreference, blueprint §8): the member can
  // switch contribution reminders off without leaving the Circle.
  reminders Boolean            @default(true)
  joinedAt  DateTime           @default(now()) @map("joined_at")
  leftAt    DateTime?          @map("left_at")

  circle        Circle                @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id])
  contributions ContributionRecord[]

  @@unique([circleId, userId])
  @@index([userId, status])
  @@map("circle_members")
}

// An invite to join a Circle, addressed to a SurePesa user (by phone or user id).
// The token is the accept link; invites expire and can be revoked.
model CircleInvitation {
  id            String                 @id @default(uuid()) @db.Uuid
  circleId      String                 @map("circle_id") @db.Uuid
  inviterId     String                 @map("inviter_id") @db.Uuid
  inviteeId     String?                @map("invitee_id") @db.Uuid
  inviteePhone  String?                @map("invitee_phone") // E.164 snapshot, shown to the invitee
  token         String                 @unique // opaque accept token
  status        CircleInvitationStatus @default(PENDING)
  expiresAt     DateTime               @map("expires_at")
  respondedAt   DateTime?              @map("responded_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  inviter  User   @relation("CircleInviter", fields: [inviterId], references: [id])
  invitee  User?  @relation("CircleInvitee", fields: [inviteeId], references: [id])

  @@index([circleId, status])
  @@index([inviteeId, status])
  @@map("circle_invitations")
}

// A defined goal inside a Circle, optionally with a contribution plan
// (expected amount/frequency — a plan, never proof of money held).
model CircleGoal {
  id                 String                 @id @default(uuid()) @db.Uuid
  circleId           String                 @map("circle_id") @db.Uuid
  title              String
  targetAmount       BigInt                 @map("target_amount") // minor units
  dueDate            DateTime?              @map("due_date") @db.Date
  status             CircleGoalStatus       @default(ACTIVE)
  expectedPerMember  BigInt?                @map("expected_per_member") // plan: minor units each
  frequency          ContributionFrequency? // plan cadence
  createdAt          DateTime               @default(now()) @map("created_at")

  circle        Circle                @relation(fields: [circleId], references: [id], onDelete: Cascade)
  contributions ContributionRecord[]

  @@index([circleId, status])
  @@map("circle_goals")
}

// One recorded contribution. PROVIDER_CONFIRMED requires transactionId pointing at a
// SUCCESS transaction initiated by that member; otherwise the record stays UNVERIFIED.
model ContributionRecord {
  id             String                   @id @default(uuid()) @db.Uuid
  circleId       String                   @map("circle_id") @db.Uuid
  goalId         String?                  @map("goal_id") @db.Uuid
  memberId       String                   @map("member_id") @db.Uuid
  amount         BigInt // minor units
  currencyCode   String                   @map("currency_code")
  source         ContributionSource
  verification   ContributionVerification
  transactionId  String?                  @map("transaction_id") @db.Uuid
  externalRef    String?                  @map("external_ref") // receipt/reference for self-reports
  note           String?
  recordedAt     DateTime                 @default(now()) @map("recorded_at")

  circle      Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  goal        CircleGoal?  @relation(fields: [goalId], references: [id])
  member      CircleMember @relation(fields: [memberId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([transactionId]) // one payment can back at most one contribution record
  @@index([circleId, recordedAt])
  @@index([memberId, recordedAt])
  @@map("contribution_records")
}

// Append-only activity/audit log of a Circle.
model CircleEvent {
  id        BigInt    @id @default(autoincrement())
  circleId  String    @map("circle_id") @db.Uuid
  actorType ActorType @default(SYSTEM) @map("actor_type")
  actorId   String?   @map("actor_id")
  action    String // CREATED, MEMBER_JOINED, GOAL_CREATED, CONTRIBUTION_RECORDED ...
  data      Json?
  createdAt DateTime  @default(now()) @map("created_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, id])
  @@map("circle_events")
}

// ──────────────────────────── Escrow ★ ────────────────────────────
//
// Protected buyer/seller deals (blueprint §10). Every funded deal has a dedicated
// ESCROW_HOLDING wallet in the central ledger — not a parallel ledger — that no
// ordinary wallet endpoint can debit. Only this module posts ESCROW_HOLD / RELEASE /
// REFUND lines, after the deal state and an authorised decision check out.

enum EscrowStatus {
  DRAFT
  AWAITING_COUNTERPARTY
  TERMS_ACCEPTED
  AWAITING_FUNDING
  FUNDING_PROCESSING
  FUNDED
  FULFILMENT_IN_PROGRESS
  AWAITING_BUYER_CONFIRMATION
  RELEASE_PENDING
  RELEASED // terminal: paid out to the seller
  DECLINED // seller declined the terms
  EXPIRED // funding deadline passed
  CANCELLED
  FUNDING_FAILED
  DISPUTED
  REFUND_PENDING
  REFUNDED // terminal: returned to the buyer
  REVIEW_REQUIRED
}

enum EscrowEvidenceType {
  PHOTO
  DOCUMENT
  TRACKING
  NOTE
  OTHER
}

enum EscrowDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum EscrowDisputeOutcome {
  RELEASE_TO_SELLER
  REFUND_BUYER
}

enum EscrowPayoutKind {
  RELEASE
  REFUND
}

enum EscrowPayoutStatus {
  PENDING
  SUCCESS
  FAILED
}

// One protected deal. The exact terms both parties accepted are pinned by termsHash.
// No automatic release: the release/inspection deadline is explicit in the terms.
model EscrowCase {
  id          String       @id @default(uuid()) @db.Uuid
  reference   String       @unique // customer-facing id, e.g. ESC-7K2M9QX4TB
  buyerId     String       @map("buyer_id") @db.Uuid
  sellerId    String       @map("seller_id") @db.Uuid
  status      EscrowStatus @default(DRAFT)

  itemDescription String @map("item_description")
  amount          BigInt // minor units; the held principal
  currencyCode    String @default("TZS") @map("currency_code")
  feeAmount       BigInt @default(0) @map("fee_amount") // disclosed service fee, charged on release
  termsHash       String @map("terms_hash") // sha256 over the exact accepted terms

  fundingDeadline DateTime @map("funding_deadline")
  deliveryDeadline DateTime? @map("delivery_deadline")
  inspectionDays   Int       @default(3) @map("inspection_days") // buyer's acceptance window after delivery

  escrowWalletId String?  @unique @map("escrow_wallet_id") @db.Uuid // the dedicated holding wallet
  fundingTransactionId String? @unique @map("funding_transaction_id") @db.Uuid
  idempotencyKey String?  @map("idempotency_key")

  fundedAt    DateTime? @map("funded_at")
  deliveredAt DateTime? @map("delivered_at")
  releasedAt  DateTime? @map("released_at")
  refundedAt  DateTime? @map("refunded_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  buyer        User             @relation("EscrowBuyer", fields: [buyerId], references: [id])
  seller       User             @relation("EscrowSeller", fields: [sellerId], references: [id])
  escrowWallet Wallet?          @relation(fields: [escrowWalletId], references: [id])
  fundingTransaction Transaction? @relation(fields: [fundingTransactionId], references: [id])
  evidence     EscrowEvidence[]
  disputes     EscrowDispute[]
  payouts      EscrowPayout[]
  events       EscrowEvent[]

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, fundingDeadline])
  @@map("escrow_cases")
}

// Delivery/fulfilment evidence. The file itself lives in private object storage;
// only its key + checksum are stored here.
model EscrowEvidence {
  id         String             @id @default(uuid()) @db.Uuid
  caseId     String             @map("case_id") @db.Uuid
  submittedBy String            @map("submitted_by") @db.Uuid
  type       EscrowEvidenceType
  storageKey String?            @map("storage_key") // private object key, never a public URL
  checksum   String? // sha256 of the file, when a file was uploaded
  note       String?
  createdAt  DateTime           @default(now()) @map("created_at")

  case       EscrowCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submittedByUser User @relation(fields: [submittedBy], references: [id])

  @@index([caseId, createdAt])
  @@map("escrow_evidence")
}

model EscrowDispute {
  id               String               @id @default(uuid()) @db.Uuid
  caseId           String               @map("case_id") @db.Uuid
  openedById       String               @map("opened_by_id") @db.Uuid
  reason           String
  requestedOutcome EscrowDisputeOutcome @map("requested_outcome")
  status           EscrowDisputeStatus  @default(OPEN)
  resolution       EscrowDisputeOutcome?
  resolvedById     String?              @map("resolved_by_id") @db.Uuid // admin
  resolutionNote   String?              @map("resolution_note")
  resolvedAt       DateTime?            @map("resolved_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  case      EscrowCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  openedBy  User       @relation("EscrowDisputeOpener", fields: [openedById], references: [id])

  @@index([caseId, status])
  @@index([status, createdAt])
  @@map("escrow_disputes")
}

// A release/refund payout instruction out of the escrow wallet. Exactly one SUCCESS
// payout per case; the idempotency key makes retries safe.
model EscrowPayout {
  id             String            @id @default(uuid()) @db.Uuid
  caseId         String            @map("case_id") @db.Uuid
  kind           EscrowPayoutKind
  amount         BigInt // minor units credited to the destination
  feeAmount      BigInt            @default(0) @map("fee_amount")
  destinationUserId String         @map("destination_user_id") @db.Uuid
  transactionId  String?           @unique @map("transaction_id") @db.Uuid
  idempotencyKey String            @map("idempotency_key")
  status         EscrowPayoutStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @map("created_at")

  case        EscrowCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([caseId, kind])
  @@index([caseId])
  @@map("escrow_payouts")
}

// Append-only event history of an escrow case.
model EscrowEvent {
  id        BigInt       @id @default(autoincrement())
  caseId    String       @map("case_id") @db.Uuid
  fromStatus EscrowStatus? @map("from_status")
  toStatus  EscrowStatus? @map("to_status")
  actorType ActorType    @default(SYSTEM) @map("actor_type")
  actorId   String?      @map("actor_id")
  action    String
  note      String?
  data      Json?
  createdAt DateTime     @default(now()) @map("created_at")

  case EscrowCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, id])
  @@map("escrow_events")
}

// The licensed custody/safeguarding account backing escrow balances (token/mask only —
// never unencrypted bank credentials). Prototype: declared by Finance for reconciliation.
model EscrowCustodyAccount {
  id               String   @id @default(uuid()) @db.Uuid
  partnerName      String   @map("partner_name")
  currencyCode     String   @map("currency_code")
  accountRefMasked String   @map("account_ref_masked")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  reconciliations EscrowReconciliation[]

  @@map("escrow_custody_accounts")
}

// Periodic reconciliation of internal escrow liabilities against custody statements.
model EscrowReconciliation {
  id                String   @id @default(uuid()) @db.Uuid
  custodyAccountId  String   @map("custody_account_id") @db.Uuid
  statementTotal    BigInt   @map("statement_total") // per the custody statement, minor units
  internalHeldTotal BigInt   @map("internal_held_total") // SUM of escrow wallet balances
  difference        BigInt // statementTotal - internalHeldTotal; must be 0
  reviewedById      String?  @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  custodyAccount EscrowCustodyAccount @relation(fields: [custodyAccountId], references: [id])

  @@index([custodyAccountId, createdAt])
  @@map("escrow_reconciliations")
}

// ──────────────────────── Borderless Payments ────────────────────────
//
// Cross-border send/receive with FX quotes (blueprint §7). Corridor and currency
// availability are data: unsupported countries/currencies are clearly unavailable,
// never simulated as live. The corridor's provider is chosen by the customer and
// never silently switched.

enum CorridorStatus {
  ACTIVE
  SUSPENDED
}

enum FxQuoteStatus {
  OPEN
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum CrossBorderStatus {
  CREATED
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  RECONCILED
  FAILED
}

// A legally/operationally supported route between two countries and currencies.
model PaymentCorridor {
  id                  String         @id @default(uuid()) @db.Uuid
  originCountry       String         @map("origin_country") // ISO 3166-1 alpha-2
  destinationCountry  String         @map("destination_country")
  sourceCurrency      String         @map("source_currency")
  destinationCurrency String         @map("destination_currency")
  allowedTypes        String[]       @default(["SEND"]) @map("allowed_types") // SEND, RECEIVE, PAY, EXCHANGE
  providerName        String         @map("provider_name") // the partner executing payouts on this corridor
  minAmount           BigInt         @map("min_amount") // source minor units
  maxAmount           BigInt         @map("max_amount")
  status              CorridorStatus @default(SUSPENDED) // new corridors start OFF until reviewed
  createdAt           DateTime       @default(now()) @map("created_at")

  quotes    FxQuote[]
  transfers CrossBorderTransfer[]

  @@unique([originCountry, destinationCountry, sourceCurrency, destinationCurrency, providerName])
  @@map("payment_corridors")
}

// A rate+fee quote with a hard expiry. The customer accepts exactly these numbers;
// an expired quote is never executed.
model FxQuote {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  corridorId          String        @map("corridor_id") @db.Uuid
  sourceAmount        BigInt        @map("source_amount") // minor units of source currency
  sourceCurrency      String        @map("source_currency")
  destinationAmount   BigInt        @map("destination_amount") // minor units the recipient gets
  destinationCurrency String        @map("destination_currency")
  rate                Decimal       @db.Decimal(24, 10) // snapshot
  exchangeRateId      String        @map("exchange_rate_id") @db.Uuid
  feeAmount           BigInt        @map("fee_amount") // charged on top, source currency
  providerName        String        @map("provider_name")
  status              FxQuoteStatus @default(OPEN)
  expiresAt           DateTime      @map("expires_at")
  acceptedAt          DateTime?     @map("accepted_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  user      User                   @relation(fields: [userId], references: [id])
  corridor  PaymentCorridor        @relation(fields: [corridorId], references: [id])
  exchangeRateRef ExchangeRate     @relation(fields: [exchangeRateId], references: [id])
  transfer  CrossBorderTransfer?

  @@index([userId, createdAt])
  @@map("fx_quotes")
}

// One cross-border transfer against an accepted quote. The ledger movement is an
// FX_CONVERSION transaction; the partner settlement is tracked separately.
model CrossBorderTransfer {
  id               String            @id @default(uuid()) @db.Uuid
  reference        String            @unique // e.g. XBT-7K2M9QX4TB
  senderId         String            @map("sender_id") @db.Uuid
  recipientId      String?           @map("recipient_id") @db.Uuid
  recipientPhone   String            @map("recipient_phone")
  recipientCountry String            @map("recipient_country")
  corridorId       String            @map("corridor_id") @db.Uuid
  quoteId          String            @unique @map("quote_id") @db.Uuid // one transfer per quote
  status           CrossBorderStatus @default(CREATED)
  transactionId    String?           @unique @map("transaction_id") @db.Uuid
  idempotencyKey   String?           @map("idempotency_key")
  failureReason    String?           @map("failure_reason")
  completedAt      DateTime?         @map("completed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  sender      User                @relation("CrossBorderSender", fields: [senderId], references: [id])
  recipient   User?               @relation("CrossBorderRecipient", fields: [recipientId], references: [id])
  corridor    PaymentCorridor     @relation(fields: [corridorId], references: [id])
  quote       FxQuote             @relation(fields: [quoteId], references: [id])
  transaction Transaction?        @relation(fields: [transactionId], references: [id])
  settlements ProviderSettlement[]

  @@unique([senderId, idempotencyKey])
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@map("cross_border_transfers")
}

// Partner settlement tracking for a transfer (references, value date, reconciliation).
model ProviderSettlement {
  id           String           @id @default(uuid()) @db.Uuid
  providerName String           @map("provider_name")
  transferId   String           @map("transfer_id") @db.Uuid
  reference    String // partner's settlement reference
  amount       BigInt
  currencyCode String           @map("currency_code")
  valueDate    DateTime?        @map("value_date")
  status       SettlementStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")

  transfer CrossBorderTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([providerName, reference])
  @@index([transferId])
  @@map("provider_settlements")
}
