# Neon: Project > Connection Details.
# Pooled connection (hostname contains "-pooler") — used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/surepesa?sslmode=require&connect_timeout=30&pool_timeout=30"
# Direct connection (no "-pooler") — used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/surepesa?sslmode=require&connect_timeout=30&pool_timeout=30"

NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (admin dashboard).
CORS_ORIGINS=http://localhost:5173

# Neon Auth (Managed Better Auth): Console > Auth
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon Object Storage (S3-compatible): Console > Storage > credentials
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.REGION.aws.neon.tech"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
KYC_BUCKET="kyc-documents"

# Simulated payment rail: secret that signs its callbacks (required in production).
SIMULATED_WEBHOOK_SECRET="generate: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
# Rail status poller interval in ms; 0 disables it (then run `npm run rail-sync` from cron).
RAIL_SYNC_INTERVAL_MS=60000

# Back-office console
ADMIN_JWT_SECRET="generate: node -e \"console.log(require('crypto').randomBytes(64).toString('base64url'))\""
